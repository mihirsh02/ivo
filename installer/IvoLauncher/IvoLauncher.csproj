<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .exe you download: IvoInstall-<version>.exe. Compiled to native code (no .NET needed to start), so a small
       "Preparing Ivo setup" card shows at once while it unpacks Ivo and the installer window (ivo.tar.br, Brotli), then
       starts the window. Its pack mode makes that archive at build time. Built by installer\build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>IvoInstall</AssemblyName>
    <ApplicationManifest>launcher.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <Version>1.0.0</Version>
    <Product Condition="'$(App)' != 'Portal'">Ivo</Product>
    <ApplicationIcon Condition="'$(App)' != 'Portal'">..\..\Assets\ivo.ico</ApplicationIcon>
    <!-- -p:App=Portal: the same launcher for Ivo Portal -->
    <Product Condition="'$(App)' == 'Portal'">Ivo Portal</Product>
    <ApplicationIcon Condition="'$(App)' == 'Portal'">..\..\Portal\portal.ico</ApplicationIcon>
    <Description>$(Product) setup</Description>
    <Archive Condition="'$(Archive)' == ''">none</Archive>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(Archive)" LogicalName="ivo.tar.br" Condition="Exists('$(Archive)')" />
  </ItemGroup>
</Project>
