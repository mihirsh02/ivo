<Application x:Class="Ivo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
>
    <Application.Resources>
        <!-- code mode's panels: purple (90%) where you're working, dark grey elsewhere (set per theme in App.ApplyTheme) -->
        <SolidColorBrush x:Key="CodeStroke" Color="#E6A78BFA" />
        <SolidColorBrush x:Key="CodeIdleStroke" Color="#3A3A42" />
        <Style x:Key="CodePanel" TargetType="Border">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource CodeIdleStroke}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource CodeStroke}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Color x:Key="A1">#7C5CFF</Color>
        <Color x:Key="A2">#22D3EE</Color>
        <Color x:Key="A3">#F472B6</Color>

        <!-- theme brushes: values are swapped at runtime by App.ApplyTheme (glow is the default) -->
        <SolidColorBrush x:Key="Bg" Color="#07070C" />
        <SolidColorBrush x:Key="Panel" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="Glass" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="GlassStroke" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="Dim" Color="#8B8BA3" />
        <SolidColorBrush x:Key="Fg" Color="#E9E9F2" />
        <SolidColorBrush x:Key="InputBg" Color="#F00D0D16" />
        <SolidColorBrush x:Key="PopupBg" Color="#FA141420" />
        <SolidColorBrush x:Key="CodeBg" Color="#B005050C" />
        <SolidColorBrush x:Key="Backdrop" Color="#B3000000" />

        <!-- Minimal theme switches: decorations hide, buttons and selections go flat (set by App.ApplyTheme) -->
        <Visibility x:Key="DecorVis">Visible</Visibility>
        <Visibility x:Key="FlatVis">Collapsed</Visibility>
        <SolidColorBrush x:Key="FlatFill" Color="#33333A" />
        <LinearGradientBrush x:Key="SegmentOn" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource A1}" Offset="0" />
            <GradientStop Color="{StaticResource A2}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource A1}" Offset="0" />
            <GradientStop Color="#4F46E5" Offset="1" />
        </LinearGradientBrush>

        <!-- small uppercase section label -->
        <!-- Settings: every section is made of groups (a quiet card with a title and a line of help) -->
        <!-- every line is exactly two screen pixels wide (App.Line) and snapped to the pixel grid, so no line lands across a pixel
             boundary and comes out wider or fainter than its neighbour. Set when each element is created, before it's drawn. -->
        <Style TargetType="Border">
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <!-- Soft theme: a diffuse shadow drawn on its own layer behind a panel (an effect on the panel itself would blur its text) -->
        <Visibility x:Key="SoftVis">Collapsed</Visibility>
        <Style x:Key="SoftShadow" TargetType="Border">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="Visibility" Value="{DynamicResource SoftVis}" />
            <Setter Property="Effect" Value="{DynamicResource SoftShadowFx}" />
        </Style>
        <!-- an on/off switch: the words on the left, a sliding pill on the right (Settings rows) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Grid DockPanel.Dock="Right" Width="40" Height="22" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="11" Background="#3A4250" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" />
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="Slide" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentGrad}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="0" />
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- every on/off in the app is a switch, as in Settings -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}" />

        <Style x:Key="Group" TargetType="Border">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="CornerRadius" Value="{DynamicResource SectionCorner}" />
            <Setter Property="Padding" Value="18,14,18,16" />
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="BorderThickness" Value="{DynamicResource SectionEdge}" />
            <Setter Property="Background" Value="{DynamicResource SectionBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SectionStroke}" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <!-- room before what the section holds; a help line right under the title tucks back up (below) -->
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Margin" Value="0,-9,0,12" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <!-- segmented pill (Magic UI style), used for settings tabs and choices -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentOn}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="Bool2Vis" />

        <!-- bare icon button (message actions): no chrome, brightens on hover -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />   <!-- never stretched tall by a high header: stays a circle -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- an icon alone sits in a circle; with words it becomes a pill -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15" Padding="7,5" MinWidth="30" MinHeight="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every other button, unless it says otherwise: a soft rounded pill in the theme's colours (not Windows' grey
             rectangle), lighter under the mouse, pressed a touch darker, faded when it can't be used. Primary actions keep
             Shimmer / the accent; icon buttons keep Ghost. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGrad}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a Ghost button with words: the same look, in the window's own font and the body text size (Ghost's icon font would
             draw words in a fallback font, a size too big) -->
        <Style x:Key="GhostText" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- shimmer button: in Glow a light band sweeps across it (one shared animation, App.ApplyTheme); flat elsewhere -->
        <Style x:Key="Shimmer" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin=".5,.5">
                        <Border x:Name="Bd" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=10, FallbackValue=10}" Padding="{TemplateBinding Padding}" Background="{DynamicResource ShimmerFill}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- settings side panel item: icon + label, accent bar and tint when selected -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8,8,8,8.01" Padding="10,7" Background="Transparent">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="13" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#A78BFA" />
            <Setter Property="Margin" Value="10,10,0,4" />
        </Style>
        <Style x:Key="NavDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource GlassStroke}" />
            <Setter Property="Margin" Value="10,12,10,0" />
        </Style>

        <!-- a choice you can turn on and off (welcome screen) -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource Glass}" />   <!-- a soft fill: a row of chips reads as buttons, not loose words -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" Padding="13,6" BorderThickness="1" BorderBrush="{DynamicResource GlassStroke}" Background="{TemplateBinding Background}">
                            <ContentPresenter TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#337C5CFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AA7C5CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- compact two-way switch (title bar Chat | Code): the chosen side is a soft raised pill -->
        <Style x:Key="Switch" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8,8,8,8.01" Padding="14,5" Background="Transparent" BorderThickness="0">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Fg}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGrad}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bare text box: just the text and caret (no theme border or focus underline) -->
        <Style x:Key="Bare" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- plain toolbar item (Minimal): text and icon only, a soft background on hover -->
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Glass}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- destructive action (Delete): solid red, brighter on hover -->
        <Style x:Key="Danger" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="#DC2626" RenderTransformOrigin=".5,.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EF4444" /></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- suggestion card: lifts on hover. No shadow effect: effects rasterise text and make it blurry. -->
        <Style x:Key="Card" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Padding="16,14" BorderThickness="1"
                                Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="-5" Duration="0:0:0.2" />
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25" />
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AA7C5CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
