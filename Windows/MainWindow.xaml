                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Show activity" Padding="12,5" Click="ShowActivity_Click" />
                                                <TextBlock Text="Activity log" Style="{StaticResource GroupTitle}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0" Text="Every change an agent made: commands it ran, files it wrote or edited, changes to your accounts, MCP and plugin calls. Secrets in them are masked; with the app lock on, the log is encrypted." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Device access" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,6" Text="What Ivo, and websites opened in it, may use. Off: never. On: websites still ask first." />
                                            <StackPanel x:Name="PrivacyList" />
