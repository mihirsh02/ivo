                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Add source" /></StackPanel>
                                            </Button>
                                            <Grid>
                                                <TextBox x:Name="SourceBox" PreviewKeyDown="SourceBox_KeyDown" />
                                                <TextBlock Text="owner/repo, or a GitHub folder link" Foreground="{DynamicResource Dim}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Visibility="{Binding Text.IsEmpty, ElementName=SourceBox, Converter={StaticResource Bool2Vis}}" />
                                            </Grid>
                                        </DockPanel>
                                        <Grid Margin="0,16,0,0">
                                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                                            <TextBox x:Name="MarketSearch" Padding="32,7,10,7" TextChanged="MarketSearch_Changed" />
                                            <TextBlock Text="Search skills" Foreground="{DynamicResource Dim}" FontSize="13" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding Text.IsEmpty, ElementName=MarketSearch, Converter={StaticResource Bool2Vis}}" />
                                        </Grid>
                                        <DockPanel Margin="0,10,0,8">
                                            <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" Padding="9,6" Click="MarketReload_Click" ToolTip="Reload from GitHub" />
                                            <TextBlock x:Name="MarketStatus" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <StackPanel x:Name="MarketList" />
                                    </StackPanel>

                                    <StackPanel x:Name="SkillsInstalled">
                                    <TextBlock Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                                               Text="A folder with a SKILL.md. Claude skills work as-is." />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource Shimmer}" Padding="14,7" Margin="0,0,8,8" Click="SkillFolder_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Add folder…" /></StackPanel>
                                        </Button>
                                        <Button Padding="12,7" Margin="0,0,8,8" Click="SkillZip_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF012;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Add .zip…" /></StackPanel>
                                        </Button>
                                        <Button Padding="12,7" Margin="0,0,8,8" Click="SkillNew_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="New" /></StackPanel>
                                        </Button>
                                        <Button Padding="12,7" Margin="0,0,8,8" Click="SkillsImportPc_Click" ToolTip="Skills from your CLI tools">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Import from this PC" /></StackPanel>
                                        </Button>
                                        <Button Content="&#xE838;" FontFamily="{DynamicResource IconFont}" Padding="10,7" Margin="0,0,8,8" Click="SkillsOpen_Click" ToolTip="Open the skills folder" />
                                        <Button Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" Padding="10,7" Margin="0,0,8,8" Click="SkillsRefresh_Click" ToolTip="Reload" />
                                    </WrapPanel>
                                    <TextBlock x:Name="SkillStatus" Foreground="MediumSeaGreen" FontSize="12" />
                                    <StackPanel x:Name="ImportPcPanel" />
                                    <TextBlock Text="YOUR SKILLS" Style="{StaticResource Label}" Margin="0,14,0,8" />
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="SkillSearch" Padding="30,6,10,6" FontSize="13" TextChanged="SkillSearch_Changed" />
                                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBlock x:Name="SkillSearchHint" Text="Search your skills" Foreground="{DynamicResource Dim}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="NoSkills" Text="None yet." Foreground="{DynamicResource Dim}" FontSize="12" />
                                    <StackPanel x:Name="SkillsList" />
                                    <TextBlock Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Scripts need a chat with a folder open." />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tools: MCP servers -->
                                <StackPanel x:Name="ConnectionsTab" Visibility="Collapsed" />
                                <StackPanel x:Name="ToolsTab" Visibility="Collapsed">
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Plugins" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Your own tools and panels, from folders with a plugin.json: any command that reads JSON and prints an answer. They work in every chat." />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="Open plugins folder" Padding="12,6" Margin="0,0,8,0" Click="OpenPlugins_Click" />
                                                <Button Content="Reload" Padding="12,6" Click="ReloadPlugins_Click" />
                                            </StackPanel>
                                            <StackPanel x:Name="PluginList" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                    <TextBlock Text="Servers" Style="{StaticResource GroupTitle}" />
                                    <TextBlock Style="{StaticResource Help}" Text="Same &quot;mcpServers&quot; JSON as Claude Desktop. Add &quot;sandbox&quot;: true to a server to run it at low integrity: it can't write to your files, settings or registry (some servers that write their own cache may then fail)." />
                                    <TextBox x:Name="McpBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Code, Consolas" FontSize="12" MinHeight="150" MaxHeight="280"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Shimmer}" Padding="14,7" Click="McpSave_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Save &amp; connect" /></StackPanel>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Content="Insert example" Padding="12,7" Margin="0,0,8,0" Click="McpExample_Click" />
                                        <TextBlock x:Name="McpError" Foreground="IndianRed" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="CONNECTED SERVERS" Style="{StaticResource Label}" Margin="0,22,0,8" />
                                    <TextBlock x:Name="NoMcp" Text="None yet." Foreground="{DynamicResource Dim}" FontSize="12" />
                                    <StackPanel x:Name="McpList" />
                                </StackPanel>
                            </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        <!-- ===== web page popup (provider usage & billing): an embedded Edge view, sign-ins are remembered ===== -->
        <Grid x:Name="WebLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="WebClose_Click" />
            <Border x:Name="WebCard" CornerRadius="16" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,12,12,10">
                        <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="13" Padding="9,7" Click="WebClose_Click" ToolTip="Close (Esc)" />
                        <Button DockPanel.Dock="Right" Content="&#xE8A7;" FontFamily="{DynamicResource IconFont}" FontSize="14" Padding="9,7" Margin="0,0,8,0" Click="WebBrowser_Click" ToolTip="Open in your browser" />
                        <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="14" Padding="9,7" Margin="0,0,8,0" Click="WebReload_Click" ToolTip="Reload" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WebTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock Text="Sign in once." FontSize="12" Foreground="{DynamicResource Dim}" />
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="WebHost" Margin="10,0,10,10" CornerRadius="10" ClipToBounds="True" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== in-window menus (chat options): clamped to the window, closes on any outside click ===== -->
        <Canvas x:Name="MenuLayer" Visibility="Collapsed" Background="Transparent" MouseDown="MenuLayer_MouseDown" Panel.ZIndex="30">
            <Border x:Name="MenuCard" CornerRadius="14" Padding="6" MinWidth="210" Background="{DynamicResource BoxBg}" BorderThickness="0" Effect="{DynamicResource SoftShadowFx}"
                    MouseDown="MenuCard_MouseDown">
                <StackPanel x:Name="MenuItems" />
            </Border>
        </Canvas>

        <!-- ===== first-launch welcome (and Settings → Profile → Edit) ===== -->
        <Grid x:Name="WelcomeLayer" Visibility="Collapsed">
            <Border Background="{DynamicResource Backdrop}" />
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Padding="36,30,36,26"
                    Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" ClipToBounds="True">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/ivo.ico" Width="26" Height="26" />
                            <TextBlock x:Name="WelcomeTitle" Text="Welcome to Ivo" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="WelcomeDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <!-- Ivo asks: her, beside the questions in her speech bubbles -->
                    <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <local:IvoAvatar Width="72" Height="72" VerticalAlignment="Top" Margin="0,0,14,0" />
                    <Grid x:Name="WelcomeSteps" Grid.Column="1" MinHeight="230">
                        <Grid.RenderTransform><TranslateTransform x:Name="WelcomeSlide" /></Grid.RenderTransform>
                        <!-- 1: name -->
                        <StackPanel>
                            <Border Background="#338B6CFF" BorderBrush="#55A78BFA" BorderThickness="1" CornerRadius="18,18,18,4" Padding="16,10,16,12" Margin="0,0,0,18" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="Hi, I'm Blub 👋" FontSize="14" Foreground="{DynamicResource Dim}" />
                                    <TextBlock Text="What should I call you?" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="ProfName" FontSize="18" Padding="12,10" Tag="Your name" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="And your birthday?" FontSize="13" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                                <DatePicker x:Name="ProfBorn" Width="150" Margin="10,0,0,0" SelectedDateFormat="Long" DisplayDateStart="1900-01-01" />
                                <TextBlock Text="optional" FontSize="12" Foreground="{DynamicResource Dim}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="You are" FontSize="13" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ToggleButton x:Name="ProfMale" Style="{StaticResource Chip}" Content="Male" Padding="14,6" Margin="0,0,8,0" Click="ProfGender_Click" />
                                <ToggleButton x:Name="ProfFemale" Style="{StaticResource Chip}" Content="Female" Padding="14,6" Click="ProfGender_Click" />
                                <TextBlock Text="optional" FontSize="12" Foreground="{DynamicResource Dim}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 2: work -->
                        <StackPanel Visibility="Collapsed">
                            <Border Background="#338B6CFF" BorderBrush="#55A78BFA" BorderThickness="1" CornerRadius="18,18,18,4" Padding="16,10,16,12" Margin="0,0,0,18" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock x:Name="WelcomeHello" Text="Nice to meet you!" FontSize="14" Foreground="{DynamicResource Dim}" />
                                    <TextBlock Text="So, what do you do?" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="ProfWork" FontSize="18" Padding="12,10" />
                            <WrapPanel x:Name="WorkChips" Margin="0,14,0,0" />
                        </StackPanel>
                        <!-- 3: uses -->
                        <StackPanel Visibility="Collapsed">
                            <Border Background="#338B6CFF" BorderBrush="#55A78BFA" BorderThickness="1" CornerRadius="18,18,18,4" Padding="16,10,16,12" Margin="0,0,0,18" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="Last one, promise ✨" FontSize="14" Foreground="{DynamicResource Dim}" />
                                    <TextBlock Text="What will you use me for?" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="I'll open on the first one you pick." FontSize="12" Foreground="{DynamicResource Dim}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <WrapPanel x:Name="UseChips" />
                            <CheckBox x:Name="ProfShare" IsChecked="True" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Fg}">Share this with the models <Run Foreground="{DynamicResource Dim}" Text="· so answers fit you" /></TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                    </Grid>
                    <Grid Margin="0,24,0,0">
                        <Button x:Name="WelcomeSkip" Content="Maybe later" Padding="14,8" HorizontalAlignment="Left" Click="WelcomeSkip_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="WelcomeBack" Content="Back" Padding="14,8" Margin="0,0,10,0" Click="WelcomeBack_Click" />
                            <Button x:Name="WelcomeNext" Style="{StaticResource Shimmer}" Padding="20,8" Click="WelcomeNext_Click" Content="Continue" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Ctrl+P: go to file ===== -->
        <Grid x:Name="QuickLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="#01000000" MouseLeftButtonDown="QuickBackdrop_Click" />
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" CornerRadius="12" Padding="8"
                    Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                <DockPanel>
                    <TextBox x:Name="QuickBox" DockPanel.Dock="Top" FontSize="14" Padding="10,7" TextChanged="QuickBox_TextChanged" PreviewKeyDown="QuickBox_KeyDown" ToolTip="File name" />
                    <ListBox x:Name="QuickList" MaxHeight="380" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" MouseLeftButtonUp="QuickList_Click"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Inbox: a floating window ¾ the size of Ivo's, cards rolling on a 3D drum ===== -->
        <Grid x:Name="WheelLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseWheel_Click" />
            <Border x:Name="WheelCard" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" RenderTransformOrigin="0.5,0.5"
                    Background="{DynamicResource BoxBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" ClipToBounds="True">
                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="24,16,16,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="FontSize" Value="16" /><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2,0" /></Style></StackPanel.Resources>   <!-- one size, one spacing -->
                            <Button Content="&#xE73A;" Foreground="#3FB950" Tag="To-do" ToolTip="To-do list" Click="InboxKind_Click" />
                            <Button x:Name="InboxReadBtn" Content="&#xE767;" ToolTip="Read today's briefing aloud" Click="InboxReadAll_Click" />
                            <Button x:Name="InboxBell" Content="&#xEA8F;" Click="InboxBell_Click" />
                            <Button Content="&#xE74D;" ToolTip="Clear (keeps starred)" Click="InboxClear_Click" />
                            <Button Content="&#xE8BB;" ToolTip="Close (Esc)" Click="CloseWheel_Click" />
                        </StackPanel>
                        <TextBlock Text="&#xE715;" FontFamily="{DynamicResource IconFont}" FontSize="20" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Inbox" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                        <TextBlock x:Name="InboxSummary" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,1,0,0" />
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="22,6,12,2">
                        <Grid Width="240" Margin="0,0,8,8">
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                            <TextBox x:Name="WheelSearch" Padding="30,5,10,5" TextChanged="WheelSearch_Changed" />
                            <TextBlock x:Name="WheelSearchHint" Text="Search the inbox" Foreground="{DynamicResource Dim}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <ComboBox x:Name="WheelWhen" Width="110" Margin="0,0,8,8" ToolTip="When" SelectionChanged="WheelPick_Changed" />
                        <ComboBox x:Name="WheelSort" Width="150" Margin="0,0,8,8" ToolTip="Sort" SelectionChanged="WheelPick_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="&#xE70E;" FontSize="14" ToolTip="Previous (↑)" Click="WheelPrev_Click" />
                            <TextBlock x:Name="WheelCount" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="4,0" />
                            <Button Style="{StaticResource Ghost}" Content="&#xE70D;" FontSize="14" ToolTip="Next (↓)" Click="WheelNext_Click" />
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel x:Name="WheelFilters" DockPanel.Dock="Top" Margin="22,0,12,4" />
                    <Grid>
                        <Canvas x:Name="WheelCanvas" Background="Transparent" ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand"
                                MouseWheel="Wheel_MouseWheel" MouseLeftButtonDown="Wheel_Down" MouseMove="Wheel_Move" MouseLeftButtonUp="Wheel_Up" KeyDown="Wheel_KeyDown"
                                SizeChanged="WheelCanvas_SizeChanged" />
                        <!-- empty: an icon and a line, like the To-do's and Reminders' -->
                        <StackPanel x:Name="WheelEmptyBox" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="420">
                            <TextBlock Text="&#xE715;" FontFamily="{DynamicResource IconFont}" FontSize="34" Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock x:Name="WheelEmpty" Text="Nothing here yet" FontSize="14" Foreground="{DynamicResource Dim}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== Inbox reader: one item, full width and nothing folded ===== -->
        <Grid x:Name="ReaderLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseReader_Click" />
            <Border x:Name="ReaderCard" MaxWidth="780" Margin="60,28,60,28" CornerRadius="16" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource EdgeStroke}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="26,20,14,6">
                        <StackPanel x:Name="ReaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" />
                        <Border x:Name="ReaderBadge" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock x:Name="ReaderIcon" FontFamily="{DynamicResource IconFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReaderName" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock x:Name="ReaderMeta" FontSize="12" Foreground="{DynamicResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ReaderTitle" DockPanel.Dock="Top" FontSize="13" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="80,4,30,0" LineHeight="20" MaxHeight="20" Cursor="Hand" ToolTip="Show or hide the prompt" MouseLeftButtonUp="ReaderTitle_Click" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource GlassStroke}" Margin="26,14,26,0" />
                    <WrapPanel x:Name="ReaderFoot" DockPanel.Dock="Bottom" Margin="26,6,26,18" />
                    <ScrollViewer x:Name="ReaderScroll" VerticalScrollBarVisibility="Auto" Padding="26,16,26,8">
                        <StackPanel x:Name="ReaderBody" MaxWidth="700" HorizontalAlignment="Left" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== planner: reminders, daily tasks, dev tasks ===== -->
        <Grid x:Name="ScheduleLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseSchedule_Click" />
            <Border x:Name="PlannerCard" MaxWidth="1180" MaxHeight="860" Margin="40,24,40,28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="18"
                    Background="{DynamicResource BoxBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <!-- the same header as every other window: icon, title, what's next, close -->
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,16,4">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Ghost}" Content="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="14" Click="CloseSchedule_Click" ToolTip="Close (Esc)" />
                        <TextBlock x:Name="PlannerIcon" Text="&#xEA8F;" FontFamily="{DynamicResource IconFont}" FontSize="20" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="PlannerTitle" Text="Reminders" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SchedSummary" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,1,0,0" />
                    </DockPanel>
                    <!-- Reminders | Daily | Dev -->
                    <DockPanel DockPanel.Dock="Left" Width="210" Margin="12,10,0,20">
                        <Border DockPanel.Dock="Right" Width="1" Background="{DynamicResource GlassStroke}" Margin="10,0,0,0" />
                        <StackPanel>
                            <RadioButton x:Name="PlannerRemTab" Style="{StaticResource NavItem}" GroupName="PlannerTab" IsChecked="True" Checked="PlannerTab_Checked">
                                <DockPanel><TextBlock x:Name="RemCount" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource Dim}" /><TextBlock><Run Text="&#xEA8F;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="#F2B84B" /><Run Text="   Reminders" /></TextBlock></DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="PlannerPlanTab" Style="{StaticResource NavItem}" GroupName="PlannerTab" Checked="PlannerTab_Checked">
                                <DockPanel><TextBlock x:Name="PlanCount" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource Dim}" /><TextBlock><Run Text="&#xE8C0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#A78BFA" /><Run Text="   My schedule" /></TextBlock></DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="PlannerTaskTab" Style="{StaticResource NavItem}" GroupName="PlannerTab" Checked="PlannerTab_Checked">
                                <DockPanel><TextBlock x:Name="DailyCount" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource Dim}" /><TextBlock><Run Text="&#xE706;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="#FB923C" /><Run Text="   Ivo's daily tasks" /></TextBlock></DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="PlannerDevTab" Style="{StaticResource NavItem}" GroupName="PlannerTab" Checked="PlannerTab_Checked">
                                <DockPanel><TextBlock x:Name="DevCount" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource Dim}" /><TextBlock><Run Text="&#xE943;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="#58A6FF" /><Run Text="   Dev tasks" /></TextBlock></DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                    <!-- to-do view -->
                    <Grid x:Name="SchedView" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6*" MinWidth="380" />
                    </Grid.ColumnDefinitions>
                    <!-- left: everything scheduled, full height -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="24,6,16,8">
                            <Button DockPanel.Dock="Right" Padding="12,5" Click="SchedNew_Click" ToolTip="Start a new one">
                                <TextBlock><Run Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="12" /><Run Text="  New" /></TextBlock>
                            </Button>
                            <Button DockPanel.Dock="Right" Padding="12,5" Margin="0,0,6,0" Content="Templates" Click="SchedTemplates_Click" ToolTip="Ready-made daily tasks: stock watch, release watch, weather and commute…" />
                            <Button x:Name="SchedWeekBtn" DockPanel.Dock="Right" Padding="12,5" Margin="0,0,6,0" Content="Week" Click="SchedWeek_Click" ToolTip="The next seven days as columns, everything together" />
                            <TextBlock x:Name="SchedListTitle" Text="Scheduled" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,20"><StackPanel x:Name="SchedList" /></ScrollViewer>
                    </DockPanel>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource GlassStroke}" Margin="0,6,0,20" />
                    <!-- right: the editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,6,28,20">
                        <TextBlock x:Name="SchedEditorTitle" Text="New" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" Margin="0,6,0,14" />
                        <!-- a form in one column of labels: What, then the kind's own rows, When, Alert -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="What" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Top" Margin="0,7,0,0" />
                            <Grid>
                                <TextBox x:Name="SchedText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="320" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="10,8" />
                                <TextBlock x:Name="SchedPlaceholder" IsHitTestVisible="False" Margin="13,8,0,0" FontSize="13" Foreground="{DynamicResource Dim}" Opacity="0.7" Text="Remind me to…" />
                            </Grid>
                        </DockPanel>
                        <StackPanel x:Name="TaskOpts" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="SchedCatLabel" Text="Category" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel>
                                    <WrapPanel x:Name="SchedCats" />
                                    <TextBox x:Name="SchedCatNew" Visibility="Collapsed" Margin="0,2,0,0" ToolTip="e.g. Stocks, Weather" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel x:Name="DevFolderRow" Margin="0,0,0,10">
                                <TextBlock Text="Folder" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" Margin="0,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Choose…" Padding="12,5" Margin="8,0,0,0" Click="DevFolder_Click" />
                                <TextBlock x:Name="DevFolderText" Text="No folder: works as a plain chat" Foreground="{DynamicResource Fg}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel x:Name="ModelRow" Margin="0,0,0,10">
                                <TextBlock Text="Model" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" Margin="0,0,0,0" />
                                <ComboBox x:Name="SchedModel" />
                            </DockPanel>
                            <DockPanel x:Name="DeliverRow" Margin="0,0,0,10">
                                <TextBlock Text="Deliver" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" Margin="0,0,0,0" />
                                <ComboBox x:Name="SchedDeliver" SelectedIndex="0">
                                    <ComboBoxItem Content="Notify me with the answer" Tag="notify" />
                                    <ComboBoxItem Content="Open the answer in Ivo" Tag="open" />
                                    <ComboBoxItem Content="Save it to a chat quietly" Tag="silent" />
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="When" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" Margin="0,0,0,0" />
                            <WrapPanel>   <!-- a narrow window: the repeat box goes under, never cut off -->
                                <DatePicker x:Name="SchedDate" Width="130" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <local:TimePicker x:Name="SchedTime" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <ComboBox x:Name="SchedRepeat" Width="170" Margin="0,0,0,4" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SchedRepeat_Changed">
                                    <ComboBoxItem Content="Once" Tag="once" />
                                    <ComboBoxItem Content="Every day" Tag="daily" />
                                    <ComboBoxItem Content="Weekdays" Tag="weekdays" />
                                    <ComboBoxItem Content="Every week" Tag="weekly" />
                                    <ComboBoxItem Content="When files change" Tag="files" ToolTip="Daily tasks: runs when files in a folder change" />
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                        <WrapPanel x:Name="SchedQuick" Margin="76,2,0,4" />
                        <DockPanel x:Name="BriefRow" Margin="0,6,0,0">
                            <TextBlock Text="Briefing" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" />
                            <CheckBox x:Name="SchedBrief" IsChecked="True" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                                      ToolTip="When the morning briefing is on and this is due before 12 pm, it arrives in the briefing instead of as its own card">
                                <TextBlock Foreground="{DynamicResource Fg}" TextWrapping="Wrap">Include in the morning briefing <Run Foreground="{DynamicResource Dim}" Text="· if due before 12 pm" /></TextBlock>
                            </CheckBox>
                        </DockPanel>
                        <DockPanel x:Name="ReminderOpts" Margin="0,6,0,0">
                            <TextBlock Text="Alert" Foreground="{DynamicResource Dim}" FontSize="12" Width="76" VerticalAlignment="Center" Margin="0,0,0,0" />
                            <!-- one switch a line, lined up on the right, as in Settings -->
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="SchedSound" IsChecked="True" Content="Sound" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                                <CheckBox x:Name="SchedSticky" IsChecked="True" Content="Stay until dismissed" Foreground="{DynamicResource Fg}" Margin="0,0,0,8" />
                                <CheckBox x:Name="SchedNag" Content="Again every 10 min until done" Foreground="{DynamicResource Fg}" ToolTip="Comes back until you mark it done in the Inbox" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0" Click="SchedAdd_Click">
                                <TextBlock><Run x:Name="SchedAddIcon" Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13" /><Run x:Name="SchedAddText" Text="  Schedule" /></TextBlock>
                            </Button>
                            <Button x:Name="SchedCancelEdit" DockPanel.Dock="Right" Content="Cancel" Padding="12,6" Visibility="Collapsed" Click="SchedCancelEdit_Click" />
                            <TextBlock x:Name="SchedNote" FontSize="12" Foreground="#F85149" VerticalAlignment="Center" Margin="76,0,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== to-do list ===== -->
        <Grid x:Name="TodoLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseTodo_Click" />
            <Border x:Name="TodoCard" MaxWidth="640" MaxHeight="760" Margin="40,24,40,28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="18"
                    Background="{DynamicResource BoxBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                    <!-- the same header as every other window: icon, title, close -->
                    <DockPanel DockPanel.Dock="Top" Margin="24,18,16,4">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Ghost}" Content="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="14" Click="CloseTodo_Click" ToolTip="Close (Esc)" />
                        <TextBlock Text="&#xE73A;" FontFamily="{DynamicResource IconFont}" FontSize="20" Foreground="#3FB950" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="To-do" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TodoSummary" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,1,0,0" />
                    </DockPanel>
                <DockPanel x:Name="TodoView">
                    <Grid DockPanel.Dock="Top" Margin="24,14,24,8">
                        <TextBox x:Name="TodoBox" FontSize="14" Padding="34,9,10,9" KeyDown="TodoBox_KeyDown" />
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0" />
                        <TextBlock x:Name="TodoPlaceholder" Text="Add a to-do: Call mom tomorrow 6pm !high #family ~Home" FontSize="14" Foreground="{DynamicResource Dim}" Opacity="0.7" IsHitTestVisible="False" VerticalAlignment="Center" Margin="37,0,12,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <WrapPanel x:Name="TodoViews" DockPanel.Dock="Top" Margin="24,0,24,6" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="24,0,24,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostText}" Content="Sync" Click="TodoSync_Click" ToolTip="Two-way sync with Notion or Google Tasks" />
                        <TextBlock x:Name="TodoSyncText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="TodoClear" DockPanel.Dock="Right" Style="{StaticResource GhostText}" Content="Clear done" Click="TodoClear_Click" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Click for details · double-click to edit" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,10"><StackPanel x:Name="TodoList" /></ScrollViewer>
                </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== in-window confirm / notice dialog ===== -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="DialogBackdrop_Click" />
            <Grid x:Name="DialogBox" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- glow on a sibling behind the card, so the card's text stays sharp -->
                <Border CornerRadius="18" Background="#7C5CFF" Opacity="0.3" Margin="8" Visibility="{DynamicResource DecorVis}">
                    <Border.Effect><BlurEffect Radius="36" /></Border.Effect>
                </Border>
                <Border CornerRadius="16" Padding="24,22,24,20" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource EdgeStroke}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="DialogIconBg" Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0" VerticalAlignment="Top">
                                <TextBlock x:Name="DialogIcon" FontFamily="{DynamicResource IconFont}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <TextBlock x:Name="DialogText" FontSize="13" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" LineHeight="20" />
                                </ScrollViewer>
                                <TextBox x:Name="DialogInput" Visibility="Collapsed" Margin="0,12,0,0" FontSize="13" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button x:Name="DialogCancel" Padding="16,8" Margin="0,0,10,0" Click="DialogCancel_Click" />
                            <Button x:Name="DialogOk" Padding="18,8" MinWidth="90" Click="DialogOk_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
