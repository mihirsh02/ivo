<Window x:Class="Ivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:Ivo"
        Title="Ivo" Width="1220" Height="780" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="/Assets/ivo.ico" Background="{DynamicResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" RenderOptions.BitmapScalingMode="HighQuality" SizeChanged="Window_SizeChanged" PreviewMouseMove="Window_MouseMove" MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_KeyDown" Activated="Window_Activated" Closing="Window_Closing" Closed="Window_Closed" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <!-- UseAeroCaptionButtons off: Ivo draws its own; on, Windows answers the top-right corner itself and paints its
             classic min/max/close and caption edge over ours -->
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
    <!-- the rail at the bottom: what you're on, typing speed and screen time (Windows/MainWindow.Activity.cs) -->
    <Border x:Name="StatusRail" DockPanel.Dock="Bottom" Height="24" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" />
    <Grid x:Name="Root" ClipToBounds="True">
        <!-- ===== Glow theme background: drifting aurora + dot grid (hidden in Dark/Light) ===== -->
        <Grid x:Name="GlowLayer" IsHitTestVisible="False">
            <Canvas Opacity="0.55">

                <!-- BitmapCache: blobs are drawn once and moved as textures, which keeps animation smooth -->
                <Ellipse Width="760" Height="760" Canvas.Left="-200" Canvas.Top="-300" CacheMode="BitmapCache">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#AA7C5CFF" /><GradientStop Color="#007C5CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B1" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="700" Height="700" Canvas.Left="600" Canvas.Top="-250" CacheMode="BitmapCache">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8822D3EE" /><GradientStop Color="#0022D3EE" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B2" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="640" Height="640" Canvas.Left="300" Canvas.Top="380" CacheMode="BitmapCache">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#66F472B6" /><GradientStop Color="#00F472B6" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B3" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
            <!-- cursor spotlight: a brighter copy of the dot grid, revealed only in a small circle around the mouse -->
            <Rectangle x:Name="DotSpot" Opacity="0">
                <Rectangle.Fill>
                    <DrawingBrush Stretch="None" AlignmentX="Left" AlignmentY="Top" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#E6B9A8FF">
                                <GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1.4" RadiusY="1.4" /></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush x:Name="SpotMask" MappingMode="Absolute" RadiusX="150" RadiusY="150" Center="-500,-500" GradientOrigin="-500,-500">
                        <GradientStop Color="#FF000000" /><GradientStop Color="#55000000" Offset="0.5" /><GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>            <Rectangle Opacity="0.35" CacheMode="BitmapCache">
                <Rectangle.Fill>
                    <DrawingBrush Stretch="None" AlignmentX="Left" AlignmentY="Top" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#33FFFFFF">
                                <GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" /></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center=".5,0" GradientOrigin=".5,0" RadiusX=".8" RadiusY="1">
                        <GradientStop Color="Black" /><GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== custom title bar ===== -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" MinWidth="34" Height="32" Margin="3,0" VerticalAlignment="Center"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><ContentPresenter.RenderTransform><ScaleTransform x:Name="Pop" /></ContentPresenter.RenderTransform></ContentPresenter></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.22" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.22" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" /><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <!-- now playing (read aloud): sound bars, what's being read, play/pause and stop -->
                    <!-- Portal: while connected, who with (and the call's time); click to go back to it -->
                    <Border x:Name="PortalPill" Visibility="Collapsed" CornerRadius="13" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" Padding="10,0,12,0" Cursor="Hand"
                            Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" MouseLeftButtonUp="PortalPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PortalDot" Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="PortalPillText" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ReadingBar" Visibility="Collapsed" CornerRadius="13" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" Padding="10,0,4,0"
                            Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1" ToolTip="Reading aloud">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel x:Name="ReadBars" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="0,0,9,0">
                                <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#A78BFA" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.4" /></Border.RenderTransform></Border>
                                <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#A78BFA" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.8" /></Border.RenderTransform></Border>
                                <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#A78BFA" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.55" /></Border.RenderTransform></Border>
                                <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#A78BFA" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform></Border>
                            </StackPanel>
                            <TextBlock x:Name="ReadTitle" MaxWidth="190" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                            <Button x:Name="ReadPauseBtn" Width="26" FontSize="12" Content="&#xE769;" ToolTip="Pause" Click="ReadPause_Click" />
                            <Button Width="26" FontSize="11" Content="&#xE71A;" ToolTip="Stop" Click="ReadStop_Click" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="TitleIcons" Orientation="Horizontal">
                        <Button x:Name="BtnTodo" Click="OpenTodos_Click" ToolTip="To-do list" Content="&#xE73A;" FontSize="20" FontFamily="{DynamicResource TitleIconFont}" Foreground="#34D399" />
                        <Button x:Name="BtnInbox" Click="OpenInbox_Click" ToolTip="Inbox">
                            <Grid>
                                <TextBlock Text="&#xE715;" FontSize="20" FontFamily="{DynamicResource TitleIconFont}" Foreground="#A78BFA" />
                                <Border x:Name="InboxDot" Visibility="Collapsed" MinWidth="15" Height="15" CornerRadius="8" Background="#F43F5E" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0">
                                    <TextBlock x:Name="InboxCount" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnStars" Click="Starred_Click" ToolTip="Starred replies" Content="&#xE734;" FontSize="20" FontFamily="{DynamicResource TitleIconFont}" Foreground="#FBBF24" />
                        <!-- light / dark: a slider, the knob carries a sun or a moon -->
                        <Button x:Name="BtnMode" Width="68" Click="Mode_Click" Visibility="Collapsed"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Center" /></ControlTemplate></Button.Template>
                            <Border x:Name="ModeTrack" Width="48" Height="24" CornerRadius="12" Padding="3" VerticalAlignment="Center">
                                <Border x:Name="ModeKnob" Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Left">
                                    <Border.RenderTransform><TranslateTransform x:Name="ModeKnobMove" /></Border.RenderTransform>
                                    <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.3" /></Border.Effect>
                                    <TextBlock x:Name="ModeIcon" FontFamily="{DynamicResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                        </Button>
                        <Button x:Name="IncognitoButton" Click="Incognito_Click" ToolTip="Incognito chat" Content="&#xED1A;" FontSize="20" FontFamily="{DynamicResource TitleIconFont}" Foreground="#F472B6" />
                    </StackPanel>
                    <Button x:Name="MinBtn" Content="&#xE921;" FontSize="14" Click="Min_Click" ToolTip="Minimize" />
                    <Button x:Name="MaxBtn" Content="&#xE922;" FontSize="13" Click="Max_Click" ToolTip="Maximize" />
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" FontSize="14" Click="Close_Click" ToolTip="Close" Margin="0,0,10,0" />
                </StackPanel>
                <StackPanel x:Name="TitleLeft" Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <!-- the mark: a flat two-tone diamond (violet and cyan facets), like VS Code's; hover for the wordmark -->
                    <Viewbox Width="26" Height="30" WindowChrome.IsHitTestVisibleInChrome="True" ToolTipService.InitialShowDelay="200" ToolTipService.Placement="Bottom">
                        <Viewbox.ToolTip>
                            <ToolTip Padding="0" BorderThickness="0" Background="Transparent" HasDropShadow="False">
                                <Border CornerRadius="12" Padding="16,12,20,14" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/ivo.ico" Width="30" Height="30" VerticalAlignment="Center" />
                                            <TextBlock x:Name="Wordmark" Text="Ivo" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Reflect">
                                                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="WordFlow" /></LinearGradientBrush.RelativeTransform>
                                                        <GradientStop Color="{StaticResource A2}" Offset="0" />
                                                        <GradientStop Color="{StaticResource A1}" Offset="0.5" />
                                                        <GradientStop Color="{StaticResource A3}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock x:Name="BrandVersion" Foreground="{DynamicResource Dim}" FontSize="12" Opacity="0.7" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </ToolTip>
                        </Viewbox.ToolTip>
                        <Canvas Width="14" Height="16">
                            <Path Data="M7,0 L7,16 L0,8 Z" Fill="#7C5CFF" />
                            <Path Data="M7,0 L14,8 L7,16 Z" Fill="#22D3EE" />
                            <Path Data="M7,0 L14,8 L7,8 Z" Fill="#FFFFFF" Opacity="0.22" />
                        </Canvas>
                    </Viewbox>
                    <!-- Chat | Code -->
                    <Border x:Name="ViewSwitch" Margin="16,0,0,0" CornerRadius="11,11,11,11.01" Padding="3" Background="{DynamicResource TrackBg}" BorderThickness="0"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <StackPanel x:Name="ViewChoices" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Switch}" GroupName="View" Tag="chat" Checked="ViewMode_Checked" ToolTip="Chats">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BD;" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,1,7,0" VerticalAlignment="Center" /><TextBlock Text="Chat" VerticalAlignment="Center" /></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Switch}" GroupName="View" Tag="code" Checked="ViewMode_Checked" ToolTip="Files and terminal">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="0,1,7,0" VerticalAlignment="Center" /><TextBlock Text="Code" VerticalAlignment="Center" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ===== the rail: places Ivo opens over the chat (Planner, Calendar, Spotify), Settings at its foot ===== -->
            <Border x:Name="Rail" Grid.Row="1" HorizontalAlignment="Left" Width="56" Margin="14,0,0,14" CornerRadius="18"
                    Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                <Border.Resources>
                    <Style x:Key="RailBtn" TargetType="Button">
                        <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,4" />
                        <Setter Property="FontFamily" Value="{DynamicResource TitleIconFont}" /><Setter Property="FontSize" Value="20" />
                        <Setter Property="Cursor" Value="Hand" /><Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" />
                                        <!-- the open one: a tinted square and a pill on the rail's edge -->
                                        <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-8,0,0,0" Background="{DynamicResource AccentGrad}" Opacity="0" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <ContentPresenter.RenderTransform><ScaleTransform x:Name="Pop" /></ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Tag" Value="on"><Setter TargetName="Bd" Property="Background" Value="#1F808080" /><Setter TargetName="Pill" Property="Opacity" Value="1" /></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.16" /><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.16" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" /><DoubleAnimation Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <DockPanel Margin="0,10">
                    <StackPanel x:Name="RailBottom" DockPanel.Dock="Bottom">
                    <Button x:Name="BtnSettings" Click="OpenSettings_Click" ToolTipService.Placement="Right" ToolTip="Settings" Content="&#xE713;" Style="{StaticResource RailBtn}" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel x:Name="RailTop">
                    <Button x:Name="BtnFocus" Click="OpenFocus_Click" ToolTip="Focus · timer and habits" Content="&#xED21;" Style="{StaticResource RailBtn}" Foreground="#F43F5E" />
                    <Button x:Name="BtnNotes" Click="OpenNotes_Click" ToolTip="Notes" Content="&#xED22;" Style="{StaticResource RailBtn}" Foreground="#FACC15" />
                    <Button x:Name="BtnOcr" Click="TextFromScreen_Click" ToolTip="Text from screen · pick an area, its text is copied" Content="&#xED25;" Style="{StaticResource RailBtn}" Foreground="#22D3EE" />
                    <Button x:Name="BtnPortal" Click="OpenPortal_Click" ToolTip="Portal · talk to another Ivo" Content="&#xED26;" Style="{StaticResource RailBtn}" Foreground="#A78BFA" />
                    <Button x:Name="BtnHooks" Click="OpenHooks_Click" ToolTip="Webhooks · Slack, Discord, Teams…" Content="&#xED23;" Style="{StaticResource RailBtn}" Foreground="#38BDF8" />
                    <Button x:Name="BtnPlanner" Click="OpenPlanner_Click" ToolTipService.Placement="Right" ToolTip="Planner · reminders, daily and dev tasks" Content="&#xE823;" Style="{StaticResource RailBtn}" Foreground="#FB923C" />
                    <Button x:Name="BtnCalendar" Click="Calendar_Click" ToolTipService.Placement="Right" ToolTip="Calendar · holidays, and schedule things on a day" Content="&#xE787;" Style="{StaticResource RailBtn}" Foreground="#38BDF8" />
                    <Button x:Name="BtnSchedule" Click="OpenMySchedule_Click" ToolTipService.Placement="Right" ToolTip="My schedule · your day, week by week" Content="&#xE8C0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource RailBtn}" Foreground="#A78BFA" />
                    <Button x:Name="BtnNews" Click="OpenNews_Click" ToolTipService.Placement="Right" ToolTip="News · latest stories by category" Style="{StaticResource RailBtn}" Foreground="#38BDF8" />
                    <Button x:Name="BtnActivity" Click="OpenActivity_Click" ToolTipService.Placement="Right" ToolTip="Activity · screen time, apps and sites, typing speed" Content="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource RailBtn}" Foreground="#22C55E" />
                    <Button x:Name="BtnSpotify" Style="{StaticResource RailBtn}" Click="OpenSpotify_Click" ToolTipService.Placement="Right" ToolTip="Spotify">
                    <!-- Spotify's mark: a green disc, three arcs -->
                    <Viewbox Width="20" Height="20" SnapsToDevicePixels="True">
                    <Canvas Width="24" Height="24">
                    <Ellipse Width="24" Height="24" Fill="#1DB954" />
                    <Path Data="M5.8,9.1 C10.2,7.8 14.9,8.2 18.4,10.3" Stroke="Black" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M6.7,12.6 C10.1,11.6 13.8,12 16.6,13.6" Stroke="Black" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M7.4,15.9 C10,15.2 12.8,15.5 15,16.7" Stroke="Black" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    </Viewbox>
                    </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="Body" Grid.Row="1" Margin="82,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition x:Name="Gap" Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== sidebar ===== -->
                <Border Style="{StaticResource SoftShadow}" CornerRadius="18" />
                <Border x:Name="Sidebar" CornerRadius="18" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                    <DockPanel>
                        <!-- New chat, pinned to the bottom of the sidebar; archived chats beside it, in a grey bubble of the same size -->
                        <Grid DockPanel.Dock="Bottom" Margin="18,6,18,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="NewChatBtn" Style="{StaticResource Shimmer}" Tag="18" HorizontalAlignment="Stretch" Height="46" Padding="0" Click="NewChat_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="New chat" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ArchiveToggle" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Shimmer}" Tag="18" Height="46" Width="58" Padding="0" Click="ArchiveToggle_Click" ToolTip="Show archived chats"
                                    FontFamily="{DynamicResource IconFont}" FontSize="19" AutomationProperties.Name="Archived chats">
                                <!-- New chat's own button, in grey: the same height and corners -->
                                <Button.Resources><SolidColorBrush x:Key="ShimmerFill" Color="#33FFFFFF" /></Button.Resources>
                            </Button>
                        </Grid>
                        <DockPanel Margin="18,18,18,8">
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,0">
                                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1" />
                                    <TextBox x:Name="ChatSearch" Padding="32,7,34,7" FontSize="13" TextChanged="ChatSearch_Changed" PreviewKeyDown="ChatSearch_KeyDown"
                                             ToolTip="Search all chats" />
                                    <Button Style="{StaticResource Ghost}" Content="&#xE734;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,4,0" Panel.ZIndex="2"
                                            ToolTip="Starred replies" Click="Starred_Click" AutomationProperties.Name="Starred replies" />
                                    <TextBlock x:Name="ChatSearchHint" Text="Search chats" Foreground="{DynamicResource Dim}" FontSize="13" Margin="33,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <!-- Blub, pinned: a chat with her, no model needed -->
                                <Button Style="{StaticResource Plain}" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0" Padding="0" Click="TalkToIvo_Click"
                                        ToolTip="Talk to Blub: she knows the app, looks things up, and needs no model" AutomationProperties.Name="Talk to Blub">
                                    <Border CornerRadius="12" Padding="10,8" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0" ClipToBounds="True">
                                                <Border.Background><ImageBrush ImageSource="/Assets/blub.png" Stretch="UniformToFill" /></Border.Background>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Blub" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                                <TextBlock Text="Your assistant · always here" FontSize="11.5" Foreground="{DynamicResource Dim}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DockPanel Margin="0,14,0,4">
                                    <TextBlock x:Name="ChatsLabel" Text="Chats" Style="{StaticResource NavGroup}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                            <ListBox x:Name="Chats" Background="Transparent" BorderThickness="0" Margin="-6,0"
                                     PreviewMouseLeftButtonUp="Chats_Click" MouseRightButtonUp="Chats_RightClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <!-- level 1: Groups / Recent, a violet heading under a divider; folds (remembered across restarts) -->
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="Head" Tag="{Binding Name}" Cursor="Hand" Loaded="GroupHead_Loaded" Click="GroupHead_Click" MouseRightButtonUp="GroupHead_RightClick" ToolTip="Right-click for project settings" HorizontalAlignment="Stretch">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="10,0,9,4">
                                                                                <DockPanel>
                                                                                    <Border DockPanel.Dock="Top" Style="{StaticResource NavDivider}" Margin="0,8,0,10" />
                                                                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource NavGroup}" Margin="0" VerticalAlignment="Center" />
                                                                                </DockPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" /></Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <ItemsPresenter Visibility="{Binding IsChecked, ElementName=Head, Converter={StaticResource Bool2Vis}}" />
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                    <!-- level 2: each group inside Groups (a quieter, foldable sub-heading; its chats indented). Recent chats have none. -->
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="Head" Tag="{Binding Name}" Cursor="Hand" Loaded="GroupHead_Loaded" Click="GroupHead_Click" MouseRightButtonUp="GroupHead_RightClick" ToolTip="Right-click for project settings" HorizontalAlignment="Stretch">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="10,6,9,2">
                                                                                <DockPanel>
                                                                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontSize="14" Width="14"
                                                                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                                </DockPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" /></Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>
                                                                <ItemsPresenter Margin="14,0,0,0" Visibility="{Binding IsChecked, ElementName=Head, Converter={StaticResource Bool2Vis}}" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <!-- Recent's chats: no sub-heading, no indent -->
                                                                <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                                    <Setter TargetName="Head" Property="Visibility" Value="Collapsed" />
                                                                    <Setter TargetName="Head" Property="IsChecked" Value="True" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8,8,8,8.01" Padding="10,2,4,2" Margin="0,1" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- title · (hover) more · pin -->
                                        <DockPanel Height="34">
                                            <DockPanel.Resources>
                                                <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource Ghost}">
                                                    <Setter Property="FontSize" Value="15" />
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Resources>
                                            <Button DockPanel.Dock="Right" Content="{Binding PinGlyph}" Tag="{Binding Pinned}" Style="{StaticResource RowIcon}"
                                                    ToolTip="{Binding PinTip}" Click="ChatPin_Click" />
                                            <Button DockPanel.Dock="Right" Content="&#xE712;" Style="{StaticResource RowIcon}" ToolTip="More options" Click="ChatMore_Click" />
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                                                       ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="1000" ToolTipService.Placement="Mouse" ToolTipService.ShowDuration="20000" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- ===== chat panes: one, or up to three equal columns in multi-chat ===== -->
                <UniformGrid x:Name="Panes" Grid.Column="2" Rows="1" />

                <!-- ===== Code mode: explorer | editor + terminal | chat ===== -->
                <Grid x:Name="CodeView" Grid.ColumnSpan="3" Visibility="Collapsed" UseLayoutRounding="True">   <!-- whole pixels: every outline the same 1px, even zoomed -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="160" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="560" MinWidth="380" />
                    </Grid.ColumnDefinitions>
                    <!-- explorer -->
                    <Border Style="{StaticResource CodePanel}" Background="{DynamicResource Panel}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <!-- Files | Chats -->
                            <Border DockPanel.Dock="Top" Margin="10,8,10,0" CornerRadius="11,11,11,11.01" Padding="3" Background="{DynamicResource TrackBg}" BorderThickness="0">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="ShowFiles" Style="{StaticResource Switch}" GroupName="ExplorerView" Content="Files" IsChecked="True" Checked="ExplorerView_Checked" />
                                    <RadioButton x:Name="ChatsToggle" Style="{StaticResource Switch}" GroupName="ExplorerView" Content="Chats" Checked="ExplorerView_Checked" />
                                    <RadioButton x:Name="GitToggle" Style="{StaticResource Switch}" GroupName="ExplorerView" Content="Git" Checked="ExplorerView_Checked" />
                                </UniformGrid>
                            </Border>
                            <DockPanel x:Name="CodeChatsView" Visibility="Collapsed">
                                <Button DockPanel.Dock="Top" Style="{StaticResource Plain}" HorizontalAlignment="Left" Margin="8,8,0,4" Click="CodeNewChat_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="New chat" /></StackPanel>
                                </Button>
                                <ListBox x:Name="CodeChatList" Background="Transparent" BorderThickness="0" Padding="4,0,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="CodeChatList_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="4,3" ToolTip="{Binding Title}" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <!-- Git: branch, changes (click for the diff), commit -->
                            <DockPanel x:Name="GitView" Visibility="Collapsed">
                                <!-- like VS Code's Source Control: a title bar, then one collapsible section per repository -->
                                <DockPanel DockPanel.Dock="Top" Margin="14,10,6,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE72C;" FontSize="14" Click="GitRefresh_Click" ToolTip="Refresh" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE8DA;" FontSize="14" Click="GitScanFolder_Click" ToolTip="Scan a folder" />
                                    <TextBlock x:Name="GitTitle" Text="SOURCE CONTROL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="GitRepos" Margin="2,0,2,10" />
                                </ScrollViewer>
                            </DockPanel>
                            <DockPanel x:Name="FilesView">
                            <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE72C;" FontSize="15" Click="RefreshTree_Click" ToolTip="Refresh" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE8DA;" FontSize="15" Click="OpenFolder_Click" ToolTip="Open a folder" />
                                <TextBlock x:Name="ExplorerTitle" Text="EXPLORER" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel x:Name="OpenFolderHint" DockPanel.Dock="Top" Margin="14,20,14,0">
                                <TextBlock Text="This chat has no folder yet." Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Shimmer}" Padding="12,7" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Open a folder" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0" Padding="4,0,4,8" MouseRightButtonUp="FileTree_RightClick" KeyDown="FileTree_KeyDown"
                                      AllowDrop="True" PreviewMouseLeftButtonDown="FileTree_PreviewMouseDown" PreviewMouseLeftButtonUp="FileTree_PreviewMouseUp" PreviewMouseMove="FileTree_PreviewMouseMove"
                                      DragOver="FileTree_DragOver" DragLeave="FileTree_DragLeave" Drop="FileTree_Drop">
                                <!-- no selected look: a file opens in its tab, a folder unfolds; only the hover shows -->
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
                                </TreeView.Resources>
                            </TreeView>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <!-- editor over terminal -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="200" MinHeight="70" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CodePanel}" Background="{DynamicResource Panel}" BorderThickness="1" CornerRadius="10">
                            <DockPanel>
                                <local:TabStrip x:Name="Tabs" SizeChanged="Tabs_SizeChanged" DockPanel.Dock="Top" Margin="4,2,4,0" ClipToBounds="True" Focusable="True" MouseEnter="TabList_MouseEnter" MouseLeave="TabList_MouseLeave" />
                                <Border x:Name="TabLine" DockPanel.Dock="Top" Height="1" Background="{DynamicResource GlassStroke}" />
                                <TextBlock x:Name="EditorStatus" DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource Dim}" Margin="14,4,14,6" TextTrimming="CharacterEllipsis" />
                                <Grid>
                                    <!-- Markdown files: a live preview beside the text (Ctrl+Shift+V), like VS Code -->
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="MdCol" Width="0" /></Grid.ColumnDefinitions>
                                    <Border x:Name="MdPane" Grid.Column="1" Visibility="Collapsed" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1,0,0,0">
                                        <ScrollViewer x:Name="MdScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="MdPreview" Margin="22,14,22,24" />
                                        </ScrollViewer>
                                    </Border>
                                    <Button x:Name="MdToggle" Visibility="Collapsed" Panel.ZIndex="4" Style="{StaticResource Ghost}" Content="&#xE8A1;" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,18,0" ToolTip="Preview (Ctrl+Shift+V)" Click="MdToggle_Click" />
                                    <ae:TextEditor x:Name="Editor" Visibility="Collapsed" ShowLineNumbers="True" WordWrap="False"
                                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="13"
                                                   Background="Transparent" Padding="6,8" Foreground="{DynamicResource Fg}" LineNumbersForeground="{DynamicResource Dim}"
                                                   TextChanged="Editor_TextChanged" />
                                    <TextBlock x:Name="EditorEmpty" Text="Open a file or press Ctrl+P" Foreground="{DynamicResource Dim}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Ctrl+H: find and replace in this file -->
                                    <Border x:Name="ReplaceBar" Visibility="Collapsed" Panel.ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,18,0" Padding="10,8"
                                            CornerRadius="10" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="6" /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBox x:Name="FindBox" ToolTip="Find" KeyDown="FindBox_KeyDown" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <CheckBox x:Name="MatchCase" Content="Aa" ToolTip="Match case" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource Ghost}" Content="&#xE74B;" FontFamily="{DynamicResource IconFont}" ToolTip="Next (Enter)" Click="FindNext_Click" />
                                                <Button Style="{StaticResource Ghost}" Content="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="12" ToolTip="Close (Esc)" Click="CloseReplace_Click" />
                                            </StackPanel>
                                            <TextBox x:Name="ReplaceBox" Grid.Row="2" ToolTip="Replace with" KeyDown="FindBox_KeyDown" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button Content="Replace" Padding="10,4" Margin="0,0,6,0" Click="ReplaceOne_Click" />
                                                <Button Content="All" Padding="10,4" Click="ReplaceAll_Click" />
                                            </StackPanel>
                                            <TextBlock x:Name="ReplaceNote" Grid.Row="3" Grid.ColumnSpan="2" FontSize="12" Foreground="{DynamicResource Dim}" Margin="2,4,0,0" />
                                        </Grid>
                                    </Border>
                                    <!-- images and other binary files: a preview or a read-only hex view -->
                                    <Grid x:Name="BinaryView" Visibility="Collapsed">
                                        <ScrollViewer x:Name="ImageView" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <Image x:Name="ImagePreview" Stretch="Uniform" StretchDirection="DownOnly" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                        <ae:TextEditor x:Name="HexView" IsReadOnly="True" ShowLineNumbers="False" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                       FontFamily="Cascadia Code, Consolas" FontSize="12" Background="Transparent" Padding="10,8" Foreground="{DynamicResource Fg}" />
                                        <Button x:Name="OpenExternallyButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,14,0" Padding="10,5" FontSize="12" Click="OpenExternally_Click" ToolTip="Open externally">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Open in its app" /></StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                        <Border x:Name="TermPanel" Grid.Row="2" Background="{DynamicResource CodeBg}" BorderThickness="0" CornerRadius="10">
                            <DockPanel>
                                <!-- the terminal list on the right: new (pick a shell) · stop · clear, then one row per terminal -->
                                <DockPanel DockPanel.Dock="Right" Width="118" Margin="0,4,4,4">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="NewTermButton" Style="{StaticResource Ghost}" Content="&#xE710;" FontSize="15" Foreground="{DynamicResource Fg}" Click="NewTerm_Click" ToolTip="New terminal" />
                                        <Button Style="{StaticResource Ghost}" Content="&#xE71A;" FontSize="15" Foreground="{DynamicResource Fg}" Click="TermStop_Click" ToolTip="Stop (Ctrl+C)" />
                                        <Button Style="{StaticResource Ghost}" Content="&#xE74D;" FontSize="15" Foreground="{DynamicResource Fg}" Click="TermClear_Click" ToolTip="Clear" />
                                    </StackPanel>
                                    <ScrollViewer x:Name="TermTabsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                                                  MouseEnter="TabList_MouseEnter" MouseLeave="TabList_MouseLeave">
                                        <StackPanel x:Name="TermTabs" />
                                    </ScrollViewer>
                                </DockPanel>
                                <Border DockPanel.Dock="Right" Width="1" Margin="0,8" Background="{DynamicResource GlassStroke}" />
                                <Border x:Name="TermHost" Margin="6,6,2,6" />   <!-- the terminal is a web view, which can't be clipped to round corners: kept clear of them -->
                            </DockPanel>
                        </Border>
                    </Grid>
                    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
                    <Border x:Name="CodeChat" Grid.Column="4" IsKeyboardFocusWithinChanged="CodeChat_FocusChanged" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== now playing (Spotify): a pill in the middle of the title bar; a click opens it downward into a player,
             like the Dynamic Island. Filled in by MainWindow.Spotify.cs ===== -->
        <Border x:Name="Island" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" Panel.ZIndex="20"
                Height="30" CornerRadius="15" Background="#000000" BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="Island_Click" Effect="{DynamicResource SoftShadowFx}">
            <!-- the theme's soft shadow: a heavy black one showed as a grey box on Light -->
            <Border.Resources>
                <Style x:Key="IslandSlider" TargetType="Slider">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <Grid Background="Transparent">
                                    <!-- what you see: a thin bar filled up to the value -->
                                    <ProgressBar Height="4" VerticalAlignment="Center" IsHitTestVisible="False"
                                                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border x:Name="PART_Track" CornerRadius="2" Background="#33FFFFFF" />
                                                    <Border x:Name="PART_Indicator" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Left" />
                                                </Grid>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <!-- what you drag: the slider's own track, invisible but for its knob on hover -->
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Knob" Width="12" Height="12" Opacity="0">
                                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFFFF" /></ControlTemplate></Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="1" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <!-- folded: cover, song · artist, sound bars -->
                <DockPanel x:Name="IslandSmall" Margin="5,0,12,0">
                    <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Border.Background><ImageBrush x:Name="MusicArt" Stretch="UniformToFill" /></Border.Background>
                    </Border>
                    <StackPanel x:Name="IslandBars" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="10,0,0,0">
                        <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#1DB954" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.5" /></Border.RenderTransform></Border>
                        <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#1DB954" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.8" /></Border.RenderTransform></Border>
                        <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#1DB954" Margin="0,0,2,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.4" /></Border.RenderTransform></Border>
                        <Border Width="2.5" Height="12" CornerRadius="1.25" Background="#1DB954" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1"><Border.RenderTransform><ScaleTransform ScaleY="0.65" /></Border.RenderTransform></Border>
                    </StackPanel>
                    <TextBlock x:Name="MusicTitle" MaxWidth="280" FontSize="12" Foreground="#EDEDF2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- open: the player -->
                <Grid x:Name="IslandBig" Visibility="Collapsed" Opacity="0" Margin="20,16,20,14" Width="420">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="12" Margin="0,0,14,0">
                            <Border.Background><ImageBrush x:Name="IslandArt" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                        <Button x:Name="IslandOpen" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Foreground="#8B8B98" VerticalAlignment="Top" FontSize="14" Content="&#xE8A7;"
                                ToolTip="Open Spotify in Ivo" Click="OpenSpotify_Click" />
                        <!-- the line being sung: here, in the room beside the song, or under the song when its details are long -->
                        <TextBlock x:Name="IslandLyricSide" DockPanel.Dock="Right" Width="160" FontSize="13.5" FontWeight="SemiBold" Foreground="#EDEDF2" TextAlignment="Right"
                                   TextWrapping="Wrap" MaxHeight="56" TextTrimming="WordEllipsis" VerticalAlignment="Center" Margin="12,0,6,0" Visibility="Collapsed" />
                        <StackPanel x:Name="IslandInfo" VerticalAlignment="Center">
                            <TextBlock x:Name="IslandSong" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="IslandArtist" FontSize="12.5" Foreground="#A0A0AE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <TextBlock x:Name="IslandDevice" FontSize="12" Foreground="#1DB954" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="IslandLyric" FontSize="13" FontWeight="SemiBold" Foreground="#EDEDF2" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="IslandAt" DockPanel.Dock="Left" Width="38" FontSize="11.5" Foreground="#8B8B98" VerticalAlignment="Center" />
                        <TextBlock x:Name="IslandLength" DockPanel.Dock="Right" Width="38" TextAlignment="Right" FontSize="11.5" Foreground="#8B8B98" VerticalAlignment="Center" />
                        <Slider x:Name="IslandSeek" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="8,0" />
                    </DockPanel>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="104" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="IslandShuffle" Style="{StaticResource Ghost}" Foreground="#A0A0AE" FontSize="14" Content="&#xE8B1;" ToolTip="Shuffle" Click="IslandShuffle_Click" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Ghost}" Foreground="#FFFFFF" FontSize="17" Content="&#xE892;" ToolTip="Previous" Click="MusicPrev_Click" Margin="4,0" VerticalAlignment="Center" />
                            <Button x:Name="MusicPlayBtn" Width="40" Height="40" Margin="4,0" FontFamily="{DynamicResource IconFont}" FontSize="15" Content="&#xE768;" Foreground="#000000" Cursor="Hand" ToolTip="Play" Click="MusicPlay_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="20" Background="#FFFFFF"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Foreground="#FFFFFF" FontSize="17" Content="&#xE893;" ToolTip="Next" Click="MusicNext_Click" Margin="4,0" VerticalAlignment="Center" />
                            <Button x:Name="IslandRepeat" Style="{StaticResource Ghost}" Foreground="#A0A0AE" FontSize="14" Content="&#xE8EE;" ToolTip="Repeat" Click="IslandRepeat_Click" VerticalAlignment="Center" />
                        </StackPanel>
                        <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE767;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="#A0A0AE" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <Slider x:Name="IslandVolume" Style="{StaticResource IslandSlider}" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Spotify: a remote for your account, opened like the Inbox (SpotifyView.cs) ===== -->
        <Grid x:Name="SpotifyLayer" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseSpotify_Click" />
            <Border x:Name="SpotifyHost" Margin="48,22,48,28" MaxWidth="1080" MaxHeight="780" />
        </Grid>

        <!-- ===== settings overlay ===== -->
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,44,0,0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="CloseSettings_Click" />
            <Border x:Name="SettingsCard" CornerRadius="12" Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                <DockPanel>
                    <!-- title bar -->
                    <DockPanel DockPanel.Dock="Top" Margin="18,10,10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="&#xE8BB;" FontSize="15" Click="CloseSettings_Click" ToolTip="Close (Esc)" />
                        <TextBlock VerticalAlignment="Center" FontSize="14">
                            <Run Text="Settings" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        </TextBlock>
                    </DockPanel>
                    <Grid Margin="8,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- side panel: sections, with counts -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,8,0">
                            <StackPanel x:Name="Nav">
                                <Grid Margin="4,0,8,8">
                                    <TextBox x:Name="SettingsSearch" Padding="30,6,8,6" FontSize="12.5" TextChanged="SettingsSearch_Changed" />
                                    <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14" Foreground="{DynamicResource Dim}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock x:Name="SettingsSearchHint" Text="Search settings" FontSize="12.5" Foreground="{DynamicResource Dim}" Opacity="0.7" IsHitTestVisible="False" VerticalAlignment="Center" Margin="30,0,0,0" />
                                </Grid>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="overview" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countoverview" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Overview" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="profile" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countprofile" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Profile &amp; memory" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="assistant" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countassistant" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Blub" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <TextBlock Text="Models" Style="{StaticResource NavGroup}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="providers" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countproviders" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="API keys" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="gateways" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countgateways" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Gateways" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="agents" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countagents" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="CLI tools" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="routing" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countrouting" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Routing" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="discover" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countdiscover" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Scan this PC" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <TextBlock Text="Extend" Style="{StaticResource NavGroup}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="subagents" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countsubagents" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Agents" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="skills" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countskills" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Skills" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="tools" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Counttools" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Tools (MCP)" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="connections" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countconnections" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Connections" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="prompts" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countprompts" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Prompts" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <TextBlock Text="App" Style="{StaticResource NavGroup}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="general" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countgeneral" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="General" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="calendar" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countcalendar" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Calendar" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="appearance" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countappearance" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Appearance" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="widgets" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countwidgets" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Widgets" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="chats" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countchats" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Chats" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="tasks" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Counttasks" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Tasks" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="usage" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countusage" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Usage" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="spending" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countspending" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Spending" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="shortcuts" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countshortcuts" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Keyboard shortcuts" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <TextBlock Text="Voice &amp; alerts" Style="{StaticResource NavGroup}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="voice" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countvoice" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Voice &amp; dictation" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="notifications" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countnotifications" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Notifications &amp; sounds" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <TextBlock Text="Privacy" Style="{StaticResource NavGroup}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="lock" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countlock" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="App lock" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="privacy" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countprivacy" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Permissions" /></DockPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="data" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countdata" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="Data &amp; storage" /></DockPanel>
                                </RadioButton>
                                <Border Style="{StaticResource NavDivider}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="about" Checked="Nav_Checked">
                                    <DockPanel><TextBlock x:Name="Countabout" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Dim}" /><TextBlock Text="About" /></DockPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- the section, centred in a large panel -->
                        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource Panel}" BorderThickness="0">   <!-- clearly darker than the settings frame, so its edge reads -->
                            <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="1000" Margin="64,44,64,40">
                                    <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                    <TextBlock x:Name="SectionHint" FontSize="13" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,8,0,18" LineHeight="21" />
                            <Grid>
                                <!-- Overview: a card for each section -->
                                <StackPanel x:Name="OverviewTab" Visibility="Collapsed">
                                    <UniformGrid x:Name="OverviewCards" Columns="4" Margin="-5,28,-5,0" />   <!-- four across: all twenty-one fit without scrolling -->
                                </StackPanel>
                                <!-- Profile -->
                                <StackPanel x:Name="ProfileTab" Visibility="Collapsed">
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <!-- filled in by DrawProfileCard: avatar, name, work, details -->
                                            <StackPanel x:Name="ProfileCard" />
                                            <WrapPanel Margin="0,14,0,0">
                                                <Button x:Name="ProfileEdit" Style="{StaticResource Shimmer}" Padding="14,6" Margin="0,0,8,0" Click="EditProfile_Click" Content="Edit profile" />
                                                <Button x:Name="ProfileClear" Padding="12,6" Click="ClearProfile_Click" Content="Clear profile" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Sharing with models" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="On: answers are tailored to your profile." />
                                            <CheckBox x:Name="ProfileShareBox" Checked="ProfileShare_Changed" Unchecked="ProfileShare_Changed">
                                                <TextBlock Foreground="{DynamicResource Fg}">Tell the models about me</TextBlock>
                                            </CheckBox>
                                            <TextBlock Text="WHAT THEY'RE TOLD" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                            <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource InputBg}">
                                                <TextBlock x:Name="ProfilePreview" FontSize="12" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource Fg}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="MemoryForgetAll" DockPanel.Dock="Right" Content="Forget all" Padding="10,4" Click="MemoryForgetAll_Click" />
                                                <TextBlock x:Name="MemoryTitle" Text="Memory" Style="{StaticResource GroupTitle}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Help}" Margin="0,4,0,12" Text="Shared by all chats except incognito. Say &quot;remember that I…&quot; to add one." />
                                            <CheckBox x:Name="MemoryReviewBox" Content="A weekly review of what's remembered, in the Inbox" Click="MemoryReview_Changed" Margin="0,0,0,12" />
                                            <StackPanel x:Name="MemoryList" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- API keys and Gateways: the same form, showing that section's presets and providers -->
                                <StackPanel x:Name="KeysTab">
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock x:Name="AddLabel" Text="Add an API key" Style="{StaticResource GroupTitle}" />
                                            <ComboBox x:Name="AddProvider" HorizontalAlignment="Stretch" SelectionChanged="AddProvider_Changed" />
                                            <StackPanel x:Name="CustomFields" Visibility="Collapsed">
                                                <TextBlock Text="NAME" Style="{StaticResource Label}" />
                                                <TextBox x:Name="CustomNameBox" />
                                            </StackPanel>
                                            <StackPanel x:Name="UrlFields" Visibility="Collapsed">
                                                <TextBlock x:Name="UrlLabel" Text="BASE URL  ·  OpenAI-compatible, for example https://api.example.com/v1" Style="{StaticResource Label}" />
                                                <TextBox x:Name="CustomUrlBox" />
                                            </StackPanel>
                                            <TextBlock x:Name="AddKeyLabel" Text="API KEY" Style="{StaticResource Label}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="AddKey" />
                                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,7" Click="TestKey_Click" ToolTip="Test the key">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Test" /></StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,7" Style="{StaticResource Shimmer}" Click="AddKey_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock x:Name="AddButtonText" Text="Add" /></StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="AddStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="AddedLabel" Text="ADDED PROVIDERS" Style="{StaticResource Label}" Margin="0,22,0,8" />
                                    <TextBlock x:Name="NoProviders" Text="None yet. Add one above." Foreground="{DynamicResource Dim}" FontSize="12" />
                                    <StackPanel x:Name="ProvidersList" />
                                    <Border Style="{StaticResource Group}" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Models on this PC (Ollama)" Style="{StaticResource GroupTitle}" />
                                            <TextBlock x:Name="OllamaStatus" Style="{StaticResource Help}" />
                                            <StackPanel x:Name="OllamaList" />
                                            <DockPanel Margin="0,10,0,0">
                                                <Button x:Name="OllamaPullBtn" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Content="Pull" Click="OllamaPull_Click" />
                                                <TextBox x:Name="OllamaPullBox" ToolTip="A model from ollama.com/library, e.g. llama3.2, qwen2.5-coder:7b, nomic-embed-text" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Routing: Auto, key pools, Ivo as a gateway -->
                                <StackPanel x:Name="RoutingTab" Visibility="Collapsed">
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Auto" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Picks a checked model and falls back when one fails." />
                                            <CheckBox x:Name="AutoOnBox" Content="Show Auto in the model picker" Click="Routing_Changed" />
                                            <DockPanel Margin="0,10,0,0">
                                                <ComboBox x:Name="AutoTriesBox" DockPanel.Dock="Right" Width="90" SelectionChanged="Routing_Changed" />
                                                <TextBlock Text="Models to try before giving up" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0">
                                                <ComboBox x:Name="AutoRestBox" DockPanel.Dock="Right" Width="90" SelectionChanged="Routing_Changed" />
                                                <TextBlock Text="Skip a failed model for (minutes)" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Providers Auto uses" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Only checked models of these are tried. CLI tools aren't used." />
                                            <WrapPanel x:Name="AutoProviders" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Key pools" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Add several keys to a provider, separated by commas." />
                                            <CheckBox x:Name="PoolBox" Content="Rotate keys, and skip ones that are out of credit" Click="Routing_Changed" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Gateway" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Let other apps on this PC use these models through Ivo." />
                                            <CheckBox x:Name="GatewayBox" Content="Use Ivo as a gateway" Click="Gateway_Click" />
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBox x:Name="GatewayPortBox" DockPanel.Dock="Right" Width="90" LostFocus="GatewayPort_Changed" />
                                                <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                                            </DockPanel>
                                            <TextBox x:Name="GatewayInfo" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock Text="Web search" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="The web_search tool works without a key, from public news and search feeds. A Brave Search API key (brave.com/search/api, needs a card on file) gives fuller, dated results." />
                                            <PasswordBox x:Name="SearchKeyBox" LostFocus="SearchKey_Changed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Agents: AI command-line tools -->
                                <StackPanel x:Name="AgentsTab" Visibility="Collapsed">
                                    <TextBlock Text="ADDED CLI TOOLS" Style="{StaticResource Label}" Margin="0,22,0,8" />
                                    <TextBlock x:Name="NoAgents" Text="None yet." Foreground="{DynamicResource Dim}" FontSize="12" />
                                    <StackPanel x:Name="AgentsList" />
                                </StackPanel>

                                <!-- Agents: specialists the chat model hands work to -->
                                <StackPanel x:Name="SubagentsTab" Visibility="Collapsed">
                                    <Border Style="{StaticResource Group}">
                                        <StackPanel>
                                            <TextBlock x:Name="AgentFormTitle" Text="New agent" Style="{StaticResource GroupTitle}" />
                                            <TextBlock Style="{StaticResource Help}" Text="Picked by description. Claude Code agents work too." />
                                            <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,4,0,6" />
                                            <TextBox x:Name="AgentName" />
                                            <TextBlock Text="WHEN TO USE IT" Style="{StaticResource Label}" />
                                            <TextBox x:Name="AgentDesc" ToolTip="e.g. Reviews code for bugs. Use after edits." />
                                            <TextBlock Text="INSTRUCTIONS" Style="{StaticResource Label}" />
                                            <TextBox x:Name="AgentInstructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="MODEL" Style="{StaticResource Label}" />
                                                    <ComboBox x:Name="AgentModel" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="ACCESS" Style="{StaticResource Label}" />
                                                    <Border CornerRadius="10" Padding="3" Background="{DynamicResource TrackBg}" BorderBrush="{DynamicResource GlassStroke}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="AgentReadOnly" Style="{StaticResource Segment}" GroupName="AgentAccess" IsChecked="True" Content="Read-only" />
                                                            <RadioButton x:Name="AgentFull" Style="{StaticResource Segment}" GroupName="AgentAccess" Content="Can make changes" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
